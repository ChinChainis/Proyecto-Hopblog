<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>Prueba de canvas</title>
        <link href="/css/style.css" type="text/css" rel="stylesheet"/>
        <!--esto resuelve la falta de favicon ico-->
        <link rel="shortcut icon" href="#">
    </head>
    <body>
        <h1>Título</h1>
        <div class="indice">
            <a href="">Inicio </a>
            <a href="">Perfil </a>
            <a href="">Usuarios</a> 
        </div>
        <span id="spantot"></span>
        <span id="span">/</span>
        <span id="spanpag"></span>

        <div class="field">
                           
            <div class="lienzoyherra">
                <div class="container">
                    <canvas id="canvas"></canvas>
                </div> 

                <div class="tools">
                    <button onClick="undo()" type="button" class="button">Undo</button>
                    <button onClick="clear_canvas()" type="button" class="button">Clear</button>

                    <div onClick="change_color(this)" class="color-field" style="background: red;"></div>
                    <div onClick="change_color(this)" class="color-field" style="background: blue;"></div>
                    <div onClick="change_color(this)" class="color-field" style="background: green;"></div>

                    <input onInput="draw_color = this.value" type="color" class="color-picker">
                    <input onInput="draw_width = this.value" type="range" min="1" max="3" class="pen-range">
                </div>
            </div> 
            <div class="undoredo">
                <button id="btn-before">Ant. Frame</button>     
                <button id="btn-next">Sig. Frame</button>     
            </div>

        </div>
        <button id="btn-download-PNG">Guardar frame</button>   
        <form enctype="multipart/form-data">
            <button id="btn-video">Guardar video</button>    
            <button id="btn-form">Envia form</button>
            <input type="text" id="fname" name="fname" value="Titulo_de_animacion"><br><br>
        </form>
            <!--<button id="btn-sql">llama sql</button>    -->

    </body>
    <script src="/funciones/funciones_canvas.js"></script>
    <!--<script src="/funciones/funciones_sql_index.js"></script>-->

</html>