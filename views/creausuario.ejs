<!doctype html>
<html lang="en">
    <head>
        <!-- Required meta tags -->
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <!-- Bootstrap CSS -->
        <link href="/css/style.css" rel="stylesheet">
        <link rel="shortcut icon" href="#">
        <title>Login System in Node.js Express</title>

    </head>
    <body class="seguridad">

        <div class="container_seg">
            <h1><b>Crea tu usuario en HopBlog</b></h1>

            <div>
                <div>&nbsp;</div>
                <div>
                <% if(session.user_email) { %>
                    
                    <h1>Hi User, Welcome <%= session.user_email %></h1>
                    <div id="enlacesapags">
                        <a href="/usuario/<%= session.user_email %>" id="enlaceaperfil">Perfil </a><br>


                        <a href="/logout" class="btn btn-primary" id="enlacealogout">Salir</a>
                    </div>
                <% } else { %>

                    <div class="card">
                        <a id="creausr" href="/seguridad">Volver a login </a><br>
                        <h3>Crea tu usuario</h3>
                        <div class="card-body">
                            <form method="post" action="/creausr">
                                <% if(usurrepe == 1) { %>
                                    <div>NOMBRE DE USUARIO REPETIDO</div>
                                <% }%>
                                <div >
                                    <label>Nombre de usuario</label>
                                    <input type="text" name="user_email" class="form-control" />
                                </div>
                                <div>
                                    <label>Contraseña</label>
                                    <input type="password" name="user_password" class="form-control" />
                                </div>
                                <div>
                                    <input type="submit" id="botonlogin" class="btn btn-primary" value="Crear" />
                                </div>
                            </form>
                        </div>
                    </div>

                <% } %>
                </div>
            </div>
        </div>
    </body>
</html>
